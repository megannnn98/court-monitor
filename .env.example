POSTGRES_DB=court_monitor
POSTGRES_USER=court_monitor
POSTGRES_PASSWORD=court_monitor_dev
DATABASE_URL=postgresql+psycopg://court_monitor:court_monitor_dev@localhost:5433/court_monitor

TOGETHER_API_KEY=
TOGETHER_MODEL=
TOGETHER_TIMEOUT_SECONDS=30

# Airtable as the editing surface for the reference lists (docs/wiki/Airtable-Sync.md).
# The pipeline never reads it: only the «Синхронизировать Airtable» button does, and
# without these the button says so instead of failing. All six are required together.
AIRTABLE_TOKEN=
# Публичные ссылки Airtable: сайт читает списки сам, без токена и без выгрузки вручную.
# Ссылка работает, пока база открыта «кому угодно на чтение».
#   Росфинмониторинг и Найденные люди — одни и те же люди, ссылка одна на двоих.
#   Источники ведутся в ДРУГОЙ базе, у них своя ссылка.
#   Должностные лица в Airtable не ведутся: этот список правят в самой базе.
AIRTABLE_SHARE_URL_RFM=
# Статьи, которые нас интересуют: 559 номеров. Ссылка из переписки с владельцем базы.
AIRTABLE_SHARE_URL_ARTICLES=
AIRTABLE_SHARE_URL_SOURCES=
AIRTABLE_SHARE_URL_KNOWN=
AIRTABLE_SHARE_URL_OFFICIALS=

AIRTABLE_BASE_ID=
AIRTABLE_SOURCES_TABLE=
AIRTABLE_RFM_PERSONS_TABLE=
AIRTABLE_KNOWN_PERSONS_TABLE=
AIRTABLE_OFFICIALS_TABLE=
# Read timeout of one sync; the Rosfinmonitoring list is ~15k records, so not short.
AIRTABLE_TIMEOUT_SECONDS=120

# Junk screen before `purge-junk` (docs/wiki/Junk-Screen.md); needs the `semantic` uv group.
# Its model is the one junk_screen_model.json names; these pick only where and how fast.
# compose.yaml turns it on for the API (JUNK_SCREEN=1); set JUNK_SCREEN=0 to turn it off.
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
# Entity Resolution v2 (calibrated on tests/fixtures/er_v2_corpus.json)
ER_CANDIDATE_LIMIT=30
ER_AUTO_LINK_MIN_SCORE=0.85
ER_REVIEW_MIN_SCORE=0.40
ER_MIN_MARGIN=0.10
# Automated monitoring (ADR 0013)
MONITORING_ENABLED_SOURCES=ovd-info,sota-vision
MONITORING_CRON="0 * * * *"
# Newest listing entries per regular run; full history only via `monitor --backfill`
MONITORING_DISCOVERY_LIMIT=50
MONITORING_STALE_RUN_AFTER_MINUTES=120
# Dagster metadata database (compose profile `monitoring`), separate from POSTGRES_DB
DAGSTER_PG_DB=court_monitor_dagster
# Database pool per process (API worker, Dagster run)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
