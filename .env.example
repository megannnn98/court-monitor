# ---- court-monitor environment template ----
# Copy to `.env` and fill real values. NEVER commit `.env`.

# Database. SQLite for local dev, PostgreSQL for production.
CM_DATABASE_URL=sqlite:///./court_monitor.db
# CM_DATABASE_URL=postgresql+psycopg://cm:cm@localhost:5432/court_monitor

# Logging
CM_LOG_LEVEL=INFO

# Config directory (YAML rules): sources, monitoring articles/keywords
CM_CONFIG_DIR=config

# HTTP client identity & politeness. Use a real contact mail/URL in production.
CM_HTTP_USER_AGENT=court-monitor/0.1 (+https://example.invalid; contact: ops@example.invalid)
CM_HTTP_TIMEOUT=20.0
CM_HTTP_PER_HOST_CONCURRENCY=2
CM_HTTP_DELAY_SECONDS=1.5

# Airtable. Mode is read_only until mapping is validated and write is explicitly enabled.
CM_AIRTABLE_MODE=read_only
# CM_AIRTABLE_TOKEN=patXXXXXXXXXXXXXXXXX

# LLM. Disabled by default — extraction runs on deterministic rules only.
CM_LLM_MODE=disabled
# CM_LLM_BASE_URL=https://api.openai.com/v1
# CM_LLM_API_KEY=sk-...
# CM_LLM_MODEL=gpt-4o-mini
